{
  "info": {
    "name": "Research Opportunity Portal API",
    "description": "CN Assignment #01 - run the requests in order (Test 1 to Test 10) with the Collection Runner. Backend must be running on http://localhost:5000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Test 1 - Create Opportunity 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "opportunities"
          ]
        },
        "description": "Expected: 201 Created",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"research_title\": \"Congestion Control in 5G Networks\",\n  \"research_description\": \"Compare TCP congestion control algorithms (Cubic, BBR) over simulated 5G links using ns-3.\",\n  \"research_area\": \"Computer Networks\",\n  \"faculty_name\": \"Dr. Sana Ahmed\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"C++, ns-3, TCP/IP\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2026-12-01\",\n  \"status\": \"Open\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Saved new ID as opportunityId1\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.id).to.be.a(\"number\");",
              "    pm.collectionVariables.set(\"opportunityId1\", json.data.id);",
              "});"
            ]
          }
        }
      ]
    },
